
const loginForm = document.querySelector("#login-form");
const registerForm = document.querySelector("#register-form");
const formTitle = document.querySelector("#form-title");
const formDescription = document.querySelector("#form-description");
const notice = document.querySelector("#notice");

// Configuração do bloqueio
const MAX_TENTATIVAS = 6;
const TEMPO_BLOQUEIO = 5 * 60 * 1000; // 5 minutos

const DEMO_KEY = "areaDelasDemoAccounts";
const TENTATIVAS_KEY = "areaDelasLoginAttempts";

// Ano automático no rodapé
document.querySelector("#current-year").textContent =
  new Date().getFullYear();

// =====================================
// CONTAS DE DEMONSTRAÇÃO
// =====================================

function getAccounts() {
  try {
    const data = localStorage.getItem(DEMO_KEY);
    const accounts = data ? JSON.parse(data) : [];

    return Array.isArray(accounts) ? accounts : [];
  } catch {
    return [];
  }
}

// =====================================
// CONTROLE DE TENTATIVAS
// =====================================

function getLoginAttempts() {
  try {
    const data = localStorage.getItem(TENTATIVAS_KEY);
    const attempts = data ? JSON.parse(data) : {};

    return attempts &&
      typeof attempts === "object" &&
      !Array.isArray(attempts)
      ? attempts
      : {};
  } catch {
    return {};
  }
}

function saveLoginAttempts(attempts) {
  localStorage.setItem(
    TENTATIVAS_KEY,
    JSON.stringify(attempts)
  );
}

function getRemainingTime(lockUntil) {
  return Math.max(
    0,
    Math.ceil((lockUntil - Date.now()) / 1000)
  );
}

function formatTime(seconds) {
  const minutes = Math.floor(seconds / 60);
  const remainingSeconds = seconds % 60;

  return `${minutes}:${String(remainingSeconds).padStart(2, "0")}`;
}

// =====================================
// MENSAGENS E VALIDAÇÃO
// =====================================

function showNotice(message, type = "error") {
  notice.textContent = message;
  notice.className = `notice ${type}`;
  notice.hidden = false;
}

function clearNotice() {
  notice.hidden = true;
  notice.textContent = "";
  notice.className = "notice";
}

function clearErrors(form) {
  form.querySelectorAll(".field-error").forEach((element) => {
    element.textContent = "";
  });

  form.querySelectorAll("input").forEach((input) => {
    input.classList.remove("invalid");
    input.removeAttribute("aria-invalid");
  });
}

function setError(inputId, message) {
  const input = document.getElementById(inputId);
  const error = document.getElementById(`${inputId}-error`);

  if (input) {
    input.classList.add("invalid");
    input.setAttribute("aria-invalid", "true");
  }

  if (error) {
    error.textContent = message;
  }
}

function isValidEmail(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

// =====================================
// ALTERNAR LOGIN E CADASTRO
// =====================================

function switchForm(destination) {
  clearNotice();
  clearErrors(loginForm);
  clearErrors(registerForm);

  const showRegister = destination === "register";

  loginForm.hidden = showRegister;
  registerForm.hidden = !showRegister;

  formTitle.textContent = showRegister
    ? "Faça parte do nosso time!"
    : "Que bom ter você de volta!";

  formDescription.textContent = showRegister
    ? "Crie sua conta e conecte-se ao futebol feminino."
    : "Entre na sua conta para continuar.";

  const firstInput = showRegister
    ? document.querySelector("#register-name")
    : document.querySelector("#login-email");

  firstInput.focus();
}

document.querySelectorAll("[data-switch]").forEach((button) => {
  button.addEventListener("click", () => {
    switchForm(button.dataset.switch);
  });
});

// =====================================
// MOSTRAR OU OCULTAR SENHA
// =====================================

document.querySelectorAll("[data-toggle]").forEach((button) => {
  button.addEventListener("click", () => {
    const input = document.getElementById(button.dataset.toggle);
    const isPassword = input.type === "password";

    input.type = isPassword ? "text" : "password";
    button.textContent = isPassword ? "Ocultar" : "Mostrar";

    button.setAttribute(
      "aria-label",
      isPassword ? "Ocultar senha" : "Mostrar senha"
    );
  });
});

// Limpar erros enquanto a pessoa corrige os campos
document.querySelectorAll("input").forEach((input) => {
  input.addEventListener("input", () => {
    input.classList.remove("invalid");
    input.removeAttribute("aria-invalid");

    const error = document.getElementById(`${input.id}-error`);

    if (error) {
      error.textContent = "";
    }

    clearNotice();
  });
});

// =====================================
// CADASTRO DE USUÁRIO
// =====================================

registerForm.addEventListener("submit", (event) => {
  event.preventDefault();

  clearNotice();
  clearErrors(registerForm);

  const name = document.querySelector("#register-name")
    .value.trim();

  const email = document.querySelector("#register-email")
    .value.trim().toLowerCase();

  const password = document.querySelector("#register-password")
    .value;

  const confirmation = document.querySelector("#confirm-password")
    .value;

  const acceptedTerms =
    document.querySelector("#accept-terms").checked;

  let valid = true;

  if (name.length < 3 || name.length > 80) {
    setError(
      "register-name",
      "Digite um nome com 3 a 80 caracteres."
    );
    valid = false;
  }

  if (!isValidEmail(email)) {
    setError(
      "register-email",
      "Digite um e-mail válido."
    );
    valid = false;
  }

  if (password.length < 8 || password.length > 128) {
    setError(
      "register-password",
      "A senha deve ter entre 8 e 128 caracteres."
    );
    valid = false;
  }

  if (!confirmation || confirmation !== password) {
    setError(
      "confirm-password",
      "As senhas precisam ser iguais."
    );
    valid = false;
  }

  if (!acceptedTerms) {
    document.querySelector("#terms-error").textContent =
      "Você precisa aceitar os termos para continuar.";

    valid = false;
  }

  if (!valid) {
    showNotice("Confira os campos destacados e tente novamente.");
    return;
  }

  const accounts = getAccounts();

  const existingAccount = accounts.some(
    (account) => account.email === email
  );

  if (existingAccount) {
    setError(
      "register-email",
      "Este e-mail já está cadastrado neste navegador."
    );

    showNotice("Já existe uma conta com esse e-mail.");
    return;
  }

  // Conta de demonstração: não usar senhas reais.
  accounts.push({
    name,
    email,
    password
  });

  try {
    localStorage.setItem(
      DEMO_KEY,
      JSON.stringify(accounts)
    );
  } catch {
    showNotice(
      "Não foi possível salvar a conta neste navegador."
    );
    return;
  }

  registerForm.reset();
  switchForm("login");

  document.querySelector("#login-email").value = email;

  showNotice(
    `Cadastro concluído, ${name}! Agora entre com seu e-mail e senha.`,
    "success"
  );
});

// =====================================
// LOGIN COM BLOQUEIO APÓS 6 ERROS
// =====================================

loginForm.addEventListener("submit", (event) => {
  event.preventDefault();

  clearNotice();
  clearErrors(loginForm);

  const email = document.querySelector("#login-email")
    .value.trim().toLowerCase();

  const password = document.querySelector("#login-password")
    .value;

  // Validar os campos
  if (!isValidEmail(email)) {
    setError("login-email", "Digite um e-mail válido.");
    showNotice("Informe um e-mail válido para continuar.");
    return;
  }

  if (!password) {
    setError("login-password", "Digite sua senha.");
    showNotice("Preencha o campo de senha.");
    return;
  }

  let attempts;

  try {
    attempts = getLoginAttempts();
  } catch {
    showNotice("Não foi possível verificar as tentativas.");
    return;
  }

  const current = attempts[email] || {
    count: 0,
    lockUntil: 0
  };

  // 1. Verificar bloqueio ativo
  if (current.lockUntil > Date.now()) {
    const remaining = getRemainingTime(current.lockUntil);

    showNotice(
      `Login bloqueado. Tente novamente em ${formatTime(remaining)}.`
    );

    return;
  }

  // 2. Reiniciar tentativas se o bloqueio expirou
  if (current.lockUntil > 0) {
    delete attempts[email];
  }

  // 3. Procurar a conta e conferir a senha
  const accounts = getAccounts();

  const account = accounts.find(
    (item) =>
      item.email === email &&
      item.password === password
  );

  // 4. Senha incorreta
  if (!account) {
    const previous = attempts[email] || {
      count: 0,
      lockUntil: 0
    };

    previous.count += 1;

    // Atingiu seis erros: bloquear por cinco minutos
    if (previous.count >= MAX_TENTATIVAS) {
      previous.lockUntil = Date.now() + TEMPO_BLOQUEIO;
      attempts[email] = previous;

      try {
        saveLoginAttempts(attempts);
      } catch {
        showNotice(
          "Não foi possível registrar o bloqueio. Tente novamente."
        );
        return;
      }

      showNotice(
        "Você errou a senha 6 vezes. O login foi bloqueado por 5 minutos."
      );

      return;
    }

    // Registrar tentativa incorreta
    attempts[email] = previous;

    try {
      saveLoginAttempts(attempts);
    } catch {
      showNotice("Não foi possível registrar a tentativa.");
      return;
    }

    const restantes = MAX_TENTATIVAS - previous.count;

    showNotice(
      `E-mail ou senha incorretos. Restam ${restantes} tentativa(s) antes do bloqueio.`
    );

    return;
  }

  // 5. Login correto: zerar tentativas
  delete attempts[email];

  try {
    saveLoginAttempts(attempts);

    const session = {
      name: account.name,
      email: account.email,
      loggedInAt: new Date().toISOString()
    };

    const remember =
      document.querySelector("#remember-me").checked;

    // Limpar sessões anteriores
    sessionStorage.removeItem("areaDelasSession");
    localStorage.removeItem("areaDelasRemembered");

    // Salvar somente os dados básicos da sessão
    const storage = remember ? localStorage : sessionStorage;

    storage.setItem(
      remember ? "areaDelasRemembered" : "areaDelasSession",
      JSON.stringify(session)
    );
  } catch {
    showNotice("Não foi possível concluir o login.");
    return;
  }

  showNotice(
    `Login realizado! Bem-vinda, ${account.name}!`,
    "success"
  );

  // Quando a página inicial estiver pronta, descomente:
  // window.location.href = "home.html";
});

// =====================================
// RECUPERAÇÃO DE SENHA (DEMONSTRAÇÃO)
// =====================================

document.querySelector("#forgot-password")
  .addEventListener("click", () => {
    clearNotice();

    const email = document.querySelector("#login-email")
      .value.trim();

    if (!isValidEmail(email)) {
      showNotice(
        "Digite um e-mail válido no campo de login para continuar."
      );

      document.querySelector("#login-email").focus();
      return;
    }

    showNotice(
      "A recuperação de senha ainda não está configurada. Ela precisará de um serviço de autenticação.",
      "success"
    );
  });
